        "$type": "typography",
        "$value": {
          "fontFamily": "{font.heading}",
          "fontWeight": 500,
          "fontSize": "2.625rem",
          "lineHeight": 1.08
        },
        "$extensions": {
          "desktop": {
            "fontSize": "3.5rem"
          },
          "use": "Home hero headline"
        }
      },
      "tagline": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.subheading}",
          "fontStyle": "normal",
          "fontWeight": 500,
          "fontSize": "1.125rem",
          "lineHeight": 1.4
        },
        "$extensions": {
          "color": "primary-strong"
        }
      },
