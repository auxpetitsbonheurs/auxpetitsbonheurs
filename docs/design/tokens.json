  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "{primitive.motion.duration.micro}",
      "$extensions": {
        "reduced": "0ms"
      }
    },
    "base": {
      "$type": "duration",
      "$value": "{primitive.motion.duration.component}",
      "$extensions": {
        "reduced": "0ms"
      }
    },
    "slow": {
      "$type": "duration",
      "$value": "{primitive.motion.duration.page}",
      "$extensions": {
        "reduced": "0ms"
      }
    },
    "reduced-motion": {
      "$description": "Under prefers-reduced-motion: reduce, replace transform/scale/slide with opacity-only fades <= 150 ms (or 0 ms); drop the basket-badge bump; no auto-advancing carousels in any mode. Nothing essential is conveyed by motion alone.",
      "duration": {
        "$type": "duration",
        "$value": "150ms"
      },
      "transform": {
        "$value": "none"
      }
    },
    "signature": {
      "basket-bump": {
        "$description": "Badge scale 1 > 1.15 > 1, duration bump, easing enter. Reduced: no scale; badge count just updates (announce via aria-live).",
        "$value": {
          "scale": 1.15,
          "duration": "{primitive.motion.duration.bump}"
        }
      },
      "order-confirmed": {
        "$description": "Single fade-up of the thank-you card, duration slow. Reduced: opacity fade only.",
        "$value": {
          "translateY": "8px",
          "duration": "{primitive.motion.duration.page}"
        }
      }
    }
  },
