{
  "$description": "Aux petits bonheurs design tokens | Source: docs/design/brand-guide.md v0.1 (PLACEHOLDER identity, Salon de the rose) | Format: W3C DTCG | Layers: primitive, semantic (light/dark via $extensions.mode), component. Swap the owner's final identity here, not in pages.",
  "primitive": {
    "color": {
      "$type": "color",
      "rose": {
        "$description": "Single accent. 300 and 500 are decorative only, never text on cream.",
        "50":  { "$value": "#FFF3F5" },
        "100": { "$value": "#FDE4E9" },
        "200": { "$value": "#F9C9D3" },
        "300": { "$value": "#F2A8B6" },
        "500": { "$value": "#D96A80" },
        "600": { "$value": "#B94762" },
        "700": { "$value": "#99344E" },
        "800": { "$value": "#7A2840" }
      },
      "cream": {
        "50":  { "$value": "#FFFFFF" },
        "100": { "$value": "#FFF8F0" },
        "200": { "$value": "#F7EBDD" }
      },
      "cocoa": {
        "$description": "Warm neutral ramp (ink in light, surfaces in dark).",
        "300": { "$value": "#CDBDB8" },
        "400": { "$value": "#A08E8A" },
        "500": { "$value": "#9C8A86" },
        "600": { "$value": "#6F6060" },
        "700": { "$value": "#3B2F2F" },
        "800": { "$value": "#33282A" },
        "850": { "$value": "#2C2223" },
        "900": { "$value": "#241B1C" }
      },
      "status": {
        "success-700": { "$value": "#2F6B4F" },
        "warning-700": { "$value": "#8A5A00" },
        "danger-700":  { "$value": "#A8322D" },
        "info-700":    { "$value": "#2E5E7E" },
        "success-300": { "$value": "#7FC8A0" },
        "warning-300": { "$value": "#E8B860" },
        "danger-300":  { "$value": "#F08A80" },
        "info-300":    { "$value": "#8EC1E0" }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": { "$value": ["Fraunces", "ui-serif", "Georgia", "serif"], "$description": "Variable, weights 500-700, axis SOFT 100, opsz auto. Self-hosted, latin + latin-ext, font-display swap." },
        "body": { "$value": ["Nunito Sans", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Variable, weights 400/600/700. Self-hosted, latin + latin-ext, font-display swap." }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 }
      },
      "lineHeight": {
        "$type": "number",
        "display": { "$value": 1.1 },
        "h1": { "$value": 1.15 },
        "h2": { "$value": 1.2 },
        "h3": { "$value": 1.25 },
        "price": { "$value": 1.2 },
        "small": { "$value": 1.45 },
        "body": { "$value": 1.5 },
        "body-lg": { "$value": 1.55 }
      },
      "axes": {
        "fraunces-soft": { "$value": 100, "$type": "number", "$description": "font-variation-settings: 'SOFT' 100" }
      }
    },
    "space": {
      "$type": "dimension",
      "$description": "4 px base.",
      "0": { "$value": "0" },
      "1": { "$value": "0.25rem" },
      "2": { "$value": "0.5rem" },
      "3": { "$value": "0.75rem" },
      "4": { "$value": "1rem" },
      "5": { "$value": "1.25rem" },
      "6": { "$value": "1.5rem" },
      "8": { "$value": "2rem" },
      "10": { "$value": "2.5rem" },
      "12": { "$value": "3rem" },
      "16": { "$value": "4rem" },
      "20": { "$value": "5rem" },
      "24": { "$value": "6rem" }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "0.5rem" },
      "md": { "$value": "0.75rem" },
      "lg": { "$value": "1rem", "$description": "Cards and photos (brand: corners 16 px)." },
      "xl": { "$value": "1.5rem" },
      "full": { "$value": "9999px" }
    },
    "shadow": {
      "$type": "shadow",
      "$description": "Warm cocoa-tinted shadows. In dark theme rely on surface lightness; use shadow.sm only.",
      "sm": { "$value": { "color": "#3B2F2F1A", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
      "md": { "$value": { "color": "#3B2F2F1F", "offsetX": "0px", "offsetY": "4px", "blur": "14px", "spread": "-2px" } },
      "lg": { "$value": { "color": "#3B2F2F29", "offsetX": "0px", "offsetY": "14px", "blur": "32px", "spread": "-6px" } }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "instant": { "$value": "0ms" },
        "micro": { "$value": "120ms", "$description": "Press, toggle, chip select (100-150)." },
        "exit": { "$value": "150ms" },
        "component": { "$value": "240ms", "$description": "Sheet, accordion, basket drawer (200-280)." },
        "page": { "$value": "300ms", "$description": "Hero/page fade (250-350). Nothing over 400." },
        "bump": { "$value": "200ms", "$description": "Basket badge scale 1 > 1.15 > 1." }
      },
      "easing": {
        "$type": "cubicBezier",
        "enter": { "$value": [0.2, 0.8, 0.2, 1] },
        "exit": { "$value": [0.42, 0, 1, 1], "$description": "ease-in" }
      }
    },
    "breakpoint": {
      "$type": "dimension",
      "$description": "Mobile first, design starts at 375 px, must work from 320 px. Use min-width queries.",
      "base": { "$value": "375px" },
      "sm": { "$value": "640px" },
      "md": { "$value": "768px", "$description": "Type scale switches mobile to desktop." },
      "lg": { "$value": "1024px" },
      "xl": { "$value": "1280px" }
    },
    "size": {
      "$type": "dimension",
      "tap-target": { "$value": "2.75rem", "$description": "44 px minimum." },
      "focus-ring-width": { "$value": "2px" },
      "focus-ring-offset": { "$value": "2px" },
      "container-max": { "$value": "72rem" },
      "measure": { "$value": "70ch", "$description": "Line length 60-75 characters." }
    }
  },
  "color": {
    "$type": "color",
    "$description": "Semantic roles. $value = light; $extensions.mode holds light and dark. shadcn variable in $extensions.shadcn.",
    "bg": { "$value": "{primitive.color.cream.100}", "$extensions": { "shadcn": "--background", "mode": { "light": "#FFF8F0", "dark": "#241B1C" } } },
    "fg": { "$value": "{primitive.color.cocoa.700}", "$extensions": { "shadcn": "--foreground", "mode": { "light": "#3B2F2F", "dark": "#FFF8F0" } } },
    "surface": { "$value": "{primitive.color.cream.50}", "$extensions": { "shadcn": "--card", "mode": { "light": "#FFFFFF", "dark": "#33282A" } } },
    "surface-fg": { "$value": "{primitive.color.cocoa.700}", "$extensions": { "shadcn": "--card-foreground", "mode": { "light": "#3B2F2F", "dark": "#FFF8F0" } } },
    "popover": { "$value": "{primitive.color.cream.50}", "$extensions": { "shadcn": "--popover", "mode": { "light": "#FFFFFF", "dark": "#33282A" } } },
    "popover-fg": { "$value": "{primitive.color.cocoa.700}", "$extensions": { "shadcn": "--popover-foreground", "mode": { "light": "#3B2F2F", "dark": "#FFF8F0" } } },
    "muted": { "$value": "{primitive.color.cream.200}", "$description": "Footer, section bands.", "$extensions": { "shadcn": "--muted", "mode": { "light": "#F7EBDD", "dark": "#2C2223" } } },
    "muted-fg": { "$value": "{primitive.color.cocoa.600}", "$extensions": { "shadcn": "--muted-foreground", "mode": { "light": "#6F6060", "dark": "#CDBDB8" } } },
    "primary": { "$value": "{primitive.color.rose.600}", "$description": "Buttons, links on cream/white.", "$extensions": { "shadcn": "--primary", "mode": { "light": "#B94762", "dark": "#F2A8B6" } } },
    "primary-fg": { "$value": "{primitive.color.cream.50}", "$extensions": { "shadcn": "--primary-foreground", "mode": { "light": "#FFFFFF", "dark": "#241B1C" } } },
    "primary-strong": { "$value": "{primitive.color.rose.700}", "$description": "Hover/pressed; text and links on rose-100 or muted bands.", "$extensions": { "mode": { "light": "#99344E", "dark": "#F9C9D3" } } },
    "accent": { "$value": "{primitive.color.rose.100}", "$description": "Selected chip, promo banner. Text on it: fg or primary-strong.", "$extensions": { "shadcn": "--accent", "mode": { "light": "#FDE4E9", "dark": "#4A3236" } } },
    "accent-fg": { "$value": "{primitive.color.cocoa.700}", "$extensions": { "shadcn": "--accent-foreground", "mode": { "light": "#3B2F2F", "dark": "#FFF8F0" } } },
    "decorative": { "$value": "{primitive.color.rose.300}", "$description": "Illustration, dividers, badge backgrounds only. Never text.", "$extensions": { "mode": { "light": "#F2A8B6", "dark": "#D96A80" } } },
    "border": { "$value": "{primitive.color.cream.200}", "$description": "Decorative hairline; never carries meaning.", "$extensions": { "shadcn": "--border", "mode": { "light": "#F7EBDD", "dark": "#443639" } } },
    "border-input": { "$value": "{primitive.color.cocoa.500}", "$description": "Input, checkbox, radio outlines (UI 3:1).", "$extensions": { "shadcn": "--input", "mode": { "light": "#9C8A86", "dark": "#A08E8A" } } },
    "ring": { "$value": "{primitive.color.rose.600}", "$extensions": { "shadcn": "--ring", "mode": { "light": "#B94762", "dark": "#F2A8B6" } } },
    "success": { "$value": "{primitive.color.status.success-700}", "$extensions": { "mode": { "light": "#2F6B4F", "dark": "#7FC8A0" } } },
    "warning": { "$value": "{primitive.color.status.warning-700}", "$extensions": { "mode": { "light": "#8A5A00", "dark": "#E8B860" } } },
    "danger": { "$value": "{primitive.color.status.danger-700}", "$extensions": { "shadcn": "--destructive", "mode": { "light": "#A8322D", "dark": "#F08A80" } } },
    "danger-fg": { "$value": "#FFFFFF", "$extensions": { "shadcn": "--destructive-foreground", "mode": { "light": "#FFFFFF", "dark": "#241B1C" } } },
    "info": { "$value": "{primitive.color.status.info-700}", "$extensions": { "mode": { "light": "#2E5E7E", "dark": "#8EC1E0" } } }
  },
  "font": {
    "heading": { "$type": "fontFamily", "$value": "{primitive.font.family.display}" },
    "body": { "$type": "fontFamily", "$value": "{primitive.font.family.body}" }
  },
  "type": {
    "scale": {
      "$description": "Mobile (base) to desktop (>= md). Body never under 14 px; inputs 16 px minimum. Sentence case, no all-caps. Prices use tabular figures (font-variant-numeric: tabular-nums).",
      "display": { "$type": "typography", "$value": { "fontFamily": "{font.heading}", "fontWeight": 600, "fontSize": "2.25rem", "lineHeight": 1.1 }, "$extensions": { "desktop": { "fontSize": "3.25rem" } } },
      "h1": { "$type": "typography", "$value": { "fontFamily": "{font.heading}", "fontWeight": 600, "fontSize": "1.875rem", "lineHeight": 1.15 }, "$extensions": { "desktop": { "fontSize": "2.5rem" } } },
      "h2": { "$type": "typography", "$value": { "fontFamily": "{font.heading}", "fontWeight": 600, "fontSize": "1.5rem", "lineHeight": 1.2 }, "$extensions": { "desktop": { "fontSize": "1.875rem" } } },
      "h3": { "$type": "typography", "$value": { "fontFamily": "{font.heading}", "fontWeight": 500, "fontSize": "1.25rem", "lineHeight": 1.25 }, "$extensions": { "desktop": { "fontSize": "1.375rem" } } },
      "body-lg": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "1.125rem", "lineHeight": 1.55 } },
      "body": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "1rem", "lineHeight": 1.5 } },
      "small": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "0.875rem", "lineHeight": 1.45 }, "$extensions": { "emphasisWeight": 600 } },
      "price": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 700, "fontSize": "1.125rem", "lineHeight": 1.2 }, "$extensions": { "desktop": { "fontSize": "1.25rem" }, "tabularNums": true } }
    }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "{primitive.motion.duration.micro}", "$extensions": { "reduced": "0ms" } },
    "base": { "$type": "duration", "$value": "{primitive.motion.duration.component}", "$extensions": { "reduced": "0ms" } },
    "slow": { "$type": "duration", "$value": "{primitive.motion.duration.page}", "$extensions": { "reduced": "0ms" } },
    "reduced-motion": {
      "$description": "Under prefers-reduced-motion: reduce, replace transform/scale/slide with opacity-only fades <= 150 ms (or 0 ms); drop the basket-badge bump; no auto-advancing carousels in any mode. Nothing essential is conveyed by motion alone.",
      "duration": { "$type": "duration", "$value": "150ms" },
      "transform": { "$value": "none" }
    },
    "signature": {
      "basket-bump": { "$description": "Badge scale 1 > 1.15 > 1, duration bump, easing enter. Reduced: no scale; badge count just updates (announce via aria-live).", "$value": { "scale": 1.15, "duration": "{primitive.motion.duration.bump}" } },
      "order-confirmed": { "$description": "Single fade-up of the thank-you card, duration slow. Reduced: opacity fade only.", "$value": { "translateY": "8px", "duration": "{primitive.motion.duration.page}" } }
    }
  },
  "component": {
    "button": { "height": { "$type": "dimension", "$value": "2.75rem" }, "radius": { "$type": "dimension", "$value": "{primitive.radius.full}" } },
    "input": { "height": { "$type": "dimension", "$value": "2.75rem" }, "radius": { "$type": "dimension", "$value": "{primitive.radius.md}" }, "fontSize": { "$type": "dimension", "$value": "1rem" } },
    "card": { "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}" }, "padding": { "$type": "dimension", "$value": "{primitive.space.4}" } },
    "chip": { "radius": { "$type": "dimension", "$value": "{primitive.radius.full}" }, "minHeight": { "$type": "dimension", "$value": "2.75rem" } },
    "image": { "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}" } }
  },
  "$extensions": {
    "contrast": {
      "standard": "WCAG 2.2 AA: text 4.5:1, large text and UI/focus 3:1. Ratios per WCAG 2.x relative luminance. Pairs marked 'brand-guide' were computed in docs/design/brand-guide.md; pairs marked 'script' were computed with the WCAG formula on 2026-11-10.",
      "light": [
        { "fg": "fg #3B2F2F", "bg": "bg #FFF8F0", "ratio": 12.2, "pass": true, "src": "brand-guide" },
        { "fg": "fg", "bg": "surface #FFFFFF", "ratio": 12.9, "pass": true, "src": "script" },
        { "fg": "muted-fg #6F6060", "bg": "bg", "ratio": 5.7, "pass": true, "src": "brand-guide" },
        { "fg": "muted-fg", "bg": "muted #F7EBDD", "ratio": 5.1, "pass": true, "src": "brand-guide" },
        { "fg": "primary #B94762", "bg": "bg", "ratio": 4.8, "pass": true, "src": "brand-guide" },
        { "fg": "primary", "bg": "surface", "ratio": 5.1, "pass": true, "src": "brand-guide" },
        { "fg": "primary-fg #FFFFFF", "bg": "primary", "ratio": 5.1, "pass": true, "src": "brand-guide" },
        { "fg": "primary-fg", "bg": "primary-strong #99344E", "ratio": 7.1, "pass": true, "src": "brand-guide" },
        { "fg": "primary-strong", "bg": "bg", "ratio": 6.8, "pass": true, "src": "brand-guide" },
        { "fg": "fg", "bg": "accent #FDE4E9", "ratio": 10.7, "pass": true, "src": "brand-guide" },
        { "fg": "primary-strong", "bg": "accent", "ratio": 5.9, "pass": true, "src": "brand-guide" },
        { "fg": "primary", "bg": "accent", "ratio": 4.2, "pass": false, "fix": "Use primary-strong for text on accent and muted bands (rule encoded in token descriptions)." },
        { "fg": "primary", "bg": "muted", "ratio": 4.3, "pass": false, "fix": "Use primary-strong for links in footer/bands." },
        { "fg": "decorative rose-500 #D96A80", "bg": "bg", "ratio": 3.2, "pass": false, "fix": "Decorative only, never text; large text 24 px+ is the sole exception." },
        { "fg": "border-input #9C8A86", "bg": "bg", "ratio": 3.1, "pass": true, "src": "brand-guide", "note": "Tight; do not lighten." },
        { "fg": "ring #B94762", "bg": "bg", "ratio": 4.8, "pass": true, "src": "brand-guide" },
        { "fg": "success #2F6B4F", "bg": "bg", "ratio": 6.0, "pass": true, "src": "brand-guide" },
        { "fg": "warning #8A5A00", "bg": "bg", "ratio": 5.6, "pass": true, "src": "brand-guide" },
        { "fg": "danger #A8322D", "bg": "bg", "ratio": 6.3, "pass": true, "src": "brand-guide" },
        { "fg": "info #2E5E7E", "bg": "bg", "ratio": 6.6, "pass": true, "src": "brand-guide" },
        { "fg": "danger-fg #FFFFFF", "bg": "danger", "ratio": 6.6, "pass": true, "src": "script" }
      ],
      "dark": [
        { "fg": "fg #FFF8F0", "bg": "bg #241B1C", "ratio": 16.0, "pass": true, "src": "brand-guide" },
        { "fg": "muted-fg #CDBDB8", "bg": "bg", "ratio": 9.3, "pass": true, "src": "brand-guide" },
        { "fg": "muted-fg", "bg": "muted #2C2223", "ratio": 8.5, "pass": true, "src": "script" },
        { "fg": "primary #F2A8B6", "bg": "bg", "ratio": 8.9, "pass": true, "src": "brand-guide" },
        { "fg": "primary-fg #241B1C", "bg": "primary", "ratio": 8.9, "pass": true, "src": "brand-guide" },
        { "fg": "fg", "bg": "surface #33282A", "ratio": 13.5, "pass": true, "src": "brand-guide" },
        { "fg": "primary", "bg": "surface", "ratio": 7.5, "pass": true, "src": "brand-guide" },
        { "fg": "fg", "bg": "accent #4A3236", "ratio": 11.1, "pass": true, "src": "script" },
        { "fg": "primary-strong #F9C9D3", "bg": "accent", "ratio": 8, "pass": true, "src": "script" },
        { "fg": "border-input #A08E8A", "bg": "bg", "ratio": 5.4, "pass": true, "src": "brand-guide" },
        { "fg": "ring #F2A8B6", "bg": "bg", "ratio": 8.9, "pass": true, "src": "brand-guide" },
        { "fg": "success / warning / danger / info", "bg": "bg", "ratio": "8.5 / 8.7 / 6.9 / 8.7", "pass": true, "src": "brand-guide" },
        { "fg": "danger-fg #241B1C", "bg": "danger #F08A80", "ratio": 6.9, "pass": true, "src": "script" }
      ],
      "failures_fixed": [
        "primary on accent (4.2) -> primary-strong",
        "primary on muted (4.3) -> primary-strong",
        "rose-500 text on cream (3.2) -> decorative token, never text"
      ]
    }
  }
}
