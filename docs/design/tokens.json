{
  "$description": "Aux petits bonheurs design tokens | Source: docs/design/brand-guide.md v0.2 (D4 Honey & cream, chosen by the Owner 2026-11-10; supersedes Salon de the rose) | Format: W3C DTCG | Layers: primitive, semantic (light/dark via $extensions.mode), component. Change identity here, not in pages.",
  "primitive": {
    "color": {
      "$type": "color",
      "honey": {
        "$description": "Single accent. 100-300 are surfaces (bands, placeholders, borders), never text. 600-800 are text, links and buttons on cream.",
        "100": { "$value": "#F7ECD9" },
        "200": { "$value": "#F1E3C8" },
        "300": { "$value": "#EFDDBD" },
        "400": { "$value": "#E2B26A", "$description": "Dark theme primary." },
        "500": { "$value": "#EBC487", "$description": "Dark theme links." },
        "550": { "$value": "#F5DDB3", "$description": "Dark theme link hover." },
        "600": { "$value": "#8C5A1E", "$description": "Light primary (buttons, focus ring)." },
        "700": { "$value": "#7D4F17", "$description": "Light links, italic tagline, button hover." },
        "800": { "$value": "#5C390F", "$description": "Light link hover." }
      },
      "cream": {
        "50":  { "$value": "#FFFDF8" },
        "100": { "$value": "#FAF5EC" },
        "200": { "$value": "#F6EEDF" }
      },
      "ink": {
        "$description": "Warm brown neutral ramp (text in light).",
        "400": { "$value": "#9C8670" },
        "500": { "$value": "#8C7862" },
        "600": { "$value": "#5E4C3A" },
        "700": { "$value": "#3A2A1C" },
        "300": { "$value": "#D4C3AA" }
      },
      "espresso": {
        "$description": "Warm dark-brown surfaces (dark theme).",
        "600": { "$value": "#3F3123" },
        "650": { "$value": "#3E3125" },
        "700": { "$value": "#3A2C1E" },
        "800": { "$value": "#2E241B" },
        "850": { "$value": "#271E17" },
        "900": { "$value": "#1C1510" }
      },
      "status": {
        "success-700": { "$value": "#2F6B4F" },
        "warning-700": { "$value": "#8A5A00" },
        "danger-700":  { "$value": "#A8322D" },
        "info-700":    { "$value": "#2E5E7E" },
        "success-300": { "$value": "#7FC8A0" },
        "warning-300": { "$value": "#E8B860" },
        "danger-300":  { "$value": "#F08A80" },
        "info-300":    { "$value": "#8EC1E0" }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": { "$value": ["Libre Caslon Display", "ui-serif", "Georgia", "serif"], "$description": "Weight 400 only (no faux bold). h1, h2, wordmark. Self-hosted (@fontsource), latin + latin-ext, font-display swap." },
        "text": { "$value": ["Libre Caslon Text", "ui-serif", "Georgia", "serif"], "$description": "400 and 400 italic. h3, card/product names, italic tagline. Self-hosted, font-display swap." },
        "body": { "$value": ["Source Sans 3", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "400 and 600. Body and UI. Self-hosted, font-display swap." }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "semibold": { "$value": 600 }
      },
      "lineHeight": {
        "$type": "number",
        "display": { "$value": 1.08 },
        "h1": { "$value": 1.12 },
        "h2": { "$value": 1.2 },
        "h3": { "$value": 1.3 },
        "price": { "$value": 1.2 },
        "small": { "$value": 1.45 },
        "body": { "$value": 1.55 },
        "body-lg": { "$value": 1.6 }
      }
    },
    "space": {
      "$type": "dimension",
      "$description": "4 px base.",
      "0": { "$value": "0" },
      "1": { "$value": "0.25rem" },
      "2": { "$value": "0.5rem" },
      "3": { "$value": "0.75rem" },
      "4": { "$value": "1rem" },
      "5": { "$value": "1.25rem" },
      "6": { "$value": "1.5rem" },
      "8": { "$value": "2rem" },
      "10": { "$value": "2.5rem" },
      "12": { "$value": "3rem" },
      "16": { "$value": "4rem" },
      "20": { "$value": "5rem" },
      "24": { "$value": "6rem" }
    },
    "radius": {
      "$type": "dimension",
      "xs": { "$value": "0.375rem", "$description": "Checkbox box." },
      "sm": { "$value": "0.625rem", "$description": "Photos inside cards, thumbnails (10 px)." },
      "md": { "$value": "0.75rem", "$description": "Buttons, inputs (12 px)." },
      "card": { "$value": "0.875rem", "$description": "Cards (14 px)." },
      "lg": { "$value": "1rem", "$description": "Soft bands, large photos (16 px)." },
      "xl": { "$value": "1.5rem" },
      "full": { "$value": "9999px", "$description": "Badges (status, sold out, count) and the radio dot only." }
    },
    "shadow": {
      "$type": "shadow",
      "$description": "Barely there: no heavy shadows. Flat cards use a 1 px honey-200 border instead. Dark theme relies on surface lightness.",
      "sm": { "$value": { "color": "#3A2A1C0F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
      "md": { "$value": { "color": "#3A2A1C1A", "offsetX": "0px", "offsetY": "2px", "blur": "10px", "spread": "-4px" } },
      "lg": { "$value": { "color": "#3A2A1C24", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-8px" } }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "instant": { "$value": "0ms" },
        "micro": { "$value": "120ms", "$description": "Press, toggle, chip select (100-150)." },
        "exit": { "$value": "150ms" },
        "component": { "$value": "240ms", "$description": "Sheet, accordion, basket drawer (200-280)." },
        "page": { "$value": "300ms", "$description": "Hero/page fade (250-350). Nothing over 400." },
        "bump": { "$value": "200ms", "$description": "Basket badge scale 1 > 1.15 > 1." }
      },
      "easing": {
        "$type": "cubicBezier",
        "enter": { "$value": [0.2, 0.8, 0.2, 1] },
        "exit": { "$value": [0.42, 0, 1, 1], "$description": "ease-in" }
      }
    },
    "breakpoint": {
      "$type": "dimension",
      "$description": "Mobile first, design starts at 375 px, must work from 320 px. Use min-width queries.",
      "base": { "$value": "375px" },
      "sm": { "$value": "640px" },
      "md": { "$value": "768px", "$description": "Type scale switches mobile to desktop." },
      "lg": { "$value": "1024px" },
      "xl": { "$value": "1280px" }
    },
    "size": {
      "$type": "dimension",
      "tap-target": { "$value": "2.75rem", "$description": "44 px minimum." },
      "button-height": { "$value": "3rem", "$description": "48 px (mockup)." },
      "focus-ring-width": { "$value": "2px" },
      "focus-ring-offset": { "$value": "2px" },
      "container-max": { "$value": "72rem" },
      "measure": { "$value": "70ch", "$description": "Line length 60-75 characters." }
    }
  },
  "color": {
    "$type": "color",
    "$description": "Semantic roles. $value = light; $extensions.mode holds light and dark. shadcn variable in $extensions.shadcn.",
    "bg": { "$value": "{primitive.color.cream.100}", "$extensions": { "shadcn": "--background", "mode": { "light": "#FAF5EC", "dark": "#1C1510" } } },
    "fg": { "$value": "{primitive.color.ink.700}", "$extensions": { "shadcn": "--foreground", "mode": { "light": "#3A2A1C", "dark": "#F6EEDF" } } },
    "surface": { "$value": "{primitive.color.cream.50}", "$description": "Cards (with a 1 px border), sheets, sticky bars.", "$extensions": { "shadcn": "--card", "mode": { "light": "#FFFDF8", "dark": "#271E17" } } },
    "surface-fg": { "$value": "{primitive.color.ink.700}", "$extensions": { "shadcn": "--card-foreground", "mode": { "light": "#3A2A1C", "dark": "#F6EEDF" } } },
    "popover": { "$value": "{primitive.color.cream.50}", "$extensions": { "shadcn": "--popover", "mode": { "light": "#FFFDF8", "dark": "#271E17" } } },
    "popover-fg": { "$value": "{primitive.color.ink.700}", "$extensions": { "shadcn": "--popover-foreground", "mode": { "light": "#3A2A1C", "dark": "#F6EEDF" } } },
    "muted": { "$value": "{primitive.color.honey.200}", "$description": "Soft bands: footer, summaries, custom-cake band.", "$extensions": { "shadcn": "--muted", "mode": { "light": "#F1E3C8", "dark": "#2E241B" } } },
    "muted-fg": { "$value": "{primitive.color.ink.600}", "$extensions": { "shadcn": "--muted-foreground", "mode": { "light": "#5E4C3A", "dark": "#D4C3AA" } } },
    "primary": { "$value": "{primitive.color.honey.600}", "$description": "Buttons, focus ring, count badge.", "$extensions": { "shadcn": "--primary", "mode": { "light": "#8C5A1E", "dark": "#E2B26A" } } },
    "primary-fg": { "$value": "{primitive.color.cream.50}", "$extensions": { "shadcn": "--primary-foreground", "mode": { "light": "#FFFDF8", "dark": "#1C1510" } } },
    "primary-strong": { "$value": "{primitive.color.honey.700}", "$description": "Links and accent text (italic tagline, prices) on every surface; button hover.", "$extensions": { "mode": { "light": "#7D4F17", "dark": "#EBC487" } } },
    "link-hover": { "$value": "{primitive.color.honey.800}", "$description": "Link hover.", "$extensions": { "mode": { "light": "#5C390F", "dark": "#F5DDB3" } } },
    "accent": { "$value": "{primitive.color.honey.100}", "$description": "Selected radio card / chip. Text on it: fg or primary-strong.", "$extensions": { "shadcn": "--accent", "mode": { "light": "#F7ECD9", "dark": "#3A2C1E" } } },
    "accent-fg": { "$value": "{primitive.color.ink.700}", "$extensions": { "shadcn": "--accent-foreground", "mode": { "light": "#3A2A1C", "dark": "#F6EEDF" } } },
    "decorative": { "$value": "{primitive.color.honey.300}", "$description": "Image placeholder and photo backdrop only. Text on it: muted-fg or fg.", "$extensions": { "mode": { "light": "#EFDDBD", "dark": "#3F3123" } } },
    "border": { "$value": "{primitive.color.honey.200}", "$description": "Card hairline (1 px); never carries meaning.", "$extensions": { "shadcn": "--border", "mode": { "light": "#F1E3C8", "dark": "#3E3125" } } },
    "border-input": { "$value": "{primitive.color.ink.500}", "$description": "Input, checkbox, radio outlines (UI 3:1 on bg, surface and muted).", "$extensions": { "shadcn": "--input", "mode": { "light": "#8C7862", "dark": "#9C8670" } } },
    "ring": { "$value": "{primitive.color.honey.600}", "$extensions": { "shadcn": "--ring", "mode": { "light": "#8C5A1E", "dark": "#E2B26A" } } },
    "success": { "$value": "{primitive.color.status.success-700}", "$extensions": { "mode": { "light": "#2F6B4F", "dark": "#7FC8A0" } } },
    "warning": { "$value": "{primitive.color.status.warning-700}", "$extensions": { "mode": { "light": "#8A5A00", "dark": "#E8B860" } } },
    "danger": { "$value": "{primitive.color.status.danger-700}", "$extensions": { "shadcn": "--destructive", "mode": { "light": "#A8322D", "dark": "#F08A80" } } },
    "danger-fg": { "$value": "{primitive.color.cream.50}", "$extensions": { "shadcn": "--destructive-foreground", "mode": { "light": "#FFFDF8", "dark": "#1C1510" } } },
    "info": { "$value": "{primitive.color.status.info-700}", "$extensions": { "mode": { "light": "#2E5E7E", "dark": "#8EC1E0" } } }
  },
  "font": {
    "heading": { "$type": "fontFamily", "$value": "{primitive.font.family.display}" },
    "subheading": { "$type": "fontFamily", "$value": "{primitive.font.family.text}" },
    "body": { "$type": "fontFamily", "$value": "{primitive.font.family.body}" }
  },
  "type": {
    "scale": {
      "$description": "Mobile (base) to desktop (>= md). Body never under 14 px; inputs 16 px minimum. Sentence case, no all-caps. Prices use tabular figures (font-variant-numeric: tabular-nums).",
      "display": { "$type": "typography", "$value": { "fontFamily": "{font.heading}", "fontWeight": 400, "fontSize": "2.625rem", "lineHeight": 1.08 }, "$extensions": { "desktop": { "fontSize": "3.5rem" }, "use": "Home hero headline" } },
      "tagline": { "$type": "typography", "$value": { "fontFamily": "{font.subheading}", "fontStyle": "italic", "fontWeight": 400, "fontSize": "1rem", "lineHeight": 1.4 }, "$extensions": { "color": "primary-strong" } },
      "h1": { "$type": "typography", "$value": { "fontFamily": "{font.heading}", "fontWeight": 400, "fontSize": "2.125rem", "lineHeight": 1.12 }, "$extensions": { "desktop": { "fontSize": "2.75rem" } } },
      "h2": { "$type": "typography", "$value": { "fontFamily": "{font.heading}", "fontWeight": 400, "fontSize": "1.75rem", "lineHeight": 1.2 }, "$extensions": { "desktop": { "fontSize": "2rem" } } },
      "h3": { "$type": "typography", "$value": { "fontFamily": "{font.subheading}", "fontWeight": 400, "fontSize": "1.25rem", "lineHeight": 1.3 }, "$extensions": { "desktop": { "fontSize": "1.375rem" } } },
      "wordmark": { "$type": "typography", "$value": { "fontFamily": "{font.heading}", "fontWeight": 400, "fontSize": "1.375rem", "lineHeight": 1.15 }, "$extensions": { "below368px": { "fontSize": "1.125rem" } } },
      "body-lg": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "1.125rem", "lineHeight": 1.6 } },
      "body": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "1rem", "lineHeight": 1.55 } },
      "small": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "0.875rem", "lineHeight": 1.45 }, "$extensions": { "emphasisWeight": 600 } },
      "price": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 600, "fontSize": "1.125rem", "lineHeight": 1.2 }, "$extensions": { "desktop": { "fontSize": "1.25rem" }, "tabularNums": true } }
    }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "{primitive.motion.duration.micro}", "$extensions": { "reduced": "0ms" } },
    "base": { "$type": "duration", "$value": "{primitive.motion.duration.component}", "$extensions": { "reduced": "0ms" } },
    "slow": { "$type": "duration", "$value": "{primitive.motion.duration.page}", "$extensions": { "reduced": "0ms" } },
    "reduced-motion": {
      "$description": "Under prefers-reduced-motion: reduce, replace transform/scale/slide with opacity-only fades <= 150 ms (or 0 ms); drop the basket-badge bump; no auto-advancing carousels in any mode. Nothing essential is conveyed by motion alone.",
      "duration": { "$type": "duration", "$value": "150ms" },
      "transform": { "$value": "none" }
    },
    "signature": {
      "basket-bump": { "$description": "Badge scale 1 > 1.15 > 1, duration bump, easing enter. Reduced: no scale; badge count just updates (announce via aria-live).", "$value": { "scale": 1.15, "duration": "{primitive.motion.duration.bump}" } },
      "order-confirmed": { "$description": "Single fade-up of the thank-you card, duration slow. Reduced: opacity fade only.", "$value": { "translateY": "8px", "duration": "{primitive.motion.duration.page}" } }
    }
  },
  "component": {
    "button": { "height": { "$type": "dimension", "$value": "{primitive.size.button-height}" }, "radius": { "$type": "dimension", "$value": "{primitive.radius.md}" } },
    "input": { "height": { "$type": "dimension", "$value": "{primitive.size.button-height}" }, "radius": { "$type": "dimension", "$value": "{primitive.radius.md}" }, "fontSize": { "$type": "dimension", "$value": "1rem" } },
    "card": { "radius": { "$type": "dimension", "$value": "{primitive.radius.card}" }, "padding": { "$type": "dimension", "$value": "{primitive.space.4}" }, "border": { "$type": "dimension", "$value": "1px", "$description": "color.border" } },
    "band": { "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}" }, "padding": { "$type": "dimension", "$value": "{primitive.space.5}" } },
    "chip": { "radius": { "$type": "dimension", "$value": "{primitive.radius.md}" }, "minHeight": { "$type": "dimension", "$value": "2.75rem" } },
    "image": { "radius": { "$type": "dimension", "$value": "{primitive.radius.lg}", "$description": "radius.sm (10 px) inside cards and for thumbnails." } }
  },
  "$extensions": {
    "contrast": {
      "standard": "WCAG 2.2 AA: text 4.5:1, large text and UI/focus 3:1. Ratios per WCAG 2.x relative luminance, computed with the WCAG formula on 2026-11-10 and rounded down to one decimal. app/lib/tokens.test.ts recomputes every passing pair.",
      "light": [
        { "fg": "fg #3A2A1C", "bg": "bg #FAF5EC", "ratio": 12.6, "pass": true, "src": "script" },
        { "fg": "fg", "bg": "surface #FFFDF8", "ratio": 13.5, "pass": true, "src": "script" },
        { "fg": "fg", "bg": "muted #F1E3C8", "ratio": 10.8, "pass": true, "src": "script" },
        { "fg": "fg", "bg": "accent #F7ECD9", "ratio": 11.7, "pass": true, "src": "script" },
        { "fg": "muted-fg #5E4C3A", "bg": "bg", "ratio": 7.5, "pass": true, "src": "script" },
        { "fg": "muted-fg", "bg": "surface", "ratio": 8.0, "pass": true, "src": "script" },
        { "fg": "muted-fg", "bg": "muted", "ratio": 6.4, "pass": true, "src": "script" },
        { "fg": "muted-fg", "bg": "decorative #EFDDBD", "ratio": 6.1, "pass": true, "src": "script" },
        { "fg": "primary #8C5A1E", "bg": "bg", "ratio": 5.3, "pass": true, "src": "script" },
        { "fg": "primary", "bg": "surface", "ratio": 5.7, "pass": true, "src": "script" },
        { "fg": "primary", "bg": "muted", "ratio": 4.6, "pass": true, "src": "script" },
        { "fg": "primary-fg #FFFDF8", "bg": "primary", "ratio": 5.7, "pass": true, "src": "script" },
        { "fg": "primary-fg", "bg": "primary-strong #7D4F17", "ratio": 6.8, "pass": true, "src": "script" },
        { "fg": "primary-strong", "bg": "bg", "ratio": 6.4, "pass": true, "src": "script" },
        { "fg": "primary-strong", "bg": "surface", "ratio": 6.8, "pass": true, "src": "script" },
        { "fg": "primary-strong", "bg": "muted", "ratio": 5.5, "pass": true, "src": "script" },
        { "fg": "primary-strong", "bg": "accent", "ratio": 5.9, "pass": true, "src": "script" },
        { "fg": "link-hover #5C390F", "bg": "bg", "ratio": 9.4, "pass": true, "src": "script" },
        { "fg": "link-hover", "bg": "muted", "ratio": 8.0, "pass": true, "src": "script" },
        { "fg": "border-input #8C7862", "bg": "bg", "ratio": 3.8, "pass": true, "src": "script" },
        { "fg": "border-input", "bg": "surface", "ratio": 4.1, "pass": true, "src": "script" },
        { "fg": "border-input", "bg": "muted", "ratio": 3.3, "pass": true, "src": "script" },
        { "fg": "ring #8C5A1E", "bg": "bg", "ratio": 5.3, "pass": true, "src": "script" },
        { "fg": "ring", "bg": "surface", "ratio": 5.7, "pass": true, "src": "script" },
        { "fg": "success / warning / danger / info", "bg": "bg", "ratio": "5.7 / 5.4 / 6.1 / 6.4", "pass": true, "src": "script" },
        { "fg": "success / warning / danger / info", "bg": "muted", "ratio": "4.9 / 4.6 / 5.2 / 5.4", "pass": true, "src": "script" },
        { "fg": "danger-fg #FFFDF8", "bg": "danger", "ratio": 6.5, "pass": true, "src": "script" },
        { "fg": "decorative honey-300 #EFDDBD", "bg": "bg", "ratio": 1.2, "pass": false, "fix": "Placeholder/backdrop surface only, never text or a UI boundary." }
      ],
      "dark": [
        { "fg": "fg #F6EEDF", "bg": "bg #1C1510", "ratio": 15.6, "pass": true, "src": "script" },
        { "fg": "fg", "bg": "surface #271E17", "ratio": 14.1, "pass": true, "src": "script" },
        { "fg": "fg", "bg": "muted #2E241B", "ratio": 13.1, "pass": true, "src": "script" },
        { "fg": "fg", "bg": "accent #3A2C1E", "ratio": 11.6, "pass": true, "src": "script" },
        { "fg": "muted-fg #D4C3AA", "bg": "bg", "ratio": 10.4, "pass": true, "src": "script" },
        { "fg": "muted-fg", "bg": "surface", "ratio": 9.4, "pass": true, "src": "script" },
        { "fg": "muted-fg", "bg": "muted", "ratio": 8.8, "pass": true, "src": "script" },
        { "fg": "muted-fg", "bg": "decorative #3F3123", "ratio": 7.2, "pass": true, "src": "script" },
        { "fg": "primary #E2B26A", "bg": "bg", "ratio": 9.2, "pass": true, "src": "script" },
        { "fg": "primary", "bg": "surface", "ratio": 8.4, "pass": true, "src": "script" },
        { "fg": "primary", "bg": "muted", "ratio": 7.8, "pass": true, "src": "script" },
        { "fg": "primary-fg #1C1510", "bg": "primary", "ratio": 9.2, "pass": true, "src": "script" },
        { "fg": "primary-fg", "bg": "primary-strong #EBC487", "ratio": 10.9, "pass": true, "src": "script" },
        { "fg": "primary-strong", "bg": "bg", "ratio": 10.9, "pass": true, "src": "script" },
        { "fg": "primary-strong", "bg": "muted", "ratio": 9.2, "pass": true, "src": "script" },
        { "fg": "primary-strong", "bg": "accent", "ratio": 8.1, "pass": true, "src": "script" },
        { "fg": "link-hover #F5DDB3", "bg": "bg", "ratio": 13.6, "pass": true, "src": "script" },
        { "fg": "border-input #9C8670", "bg": "bg", "ratio": 5.2, "pass": true, "src": "script" },
        { "fg": "border-input", "bg": "surface", "ratio": 4.7, "pass": true, "src": "script" },
        { "fg": "border-input", "bg": "muted", "ratio": 4.3, "pass": true, "src": "script" },
        { "fg": "ring #E2B26A", "bg": "bg", "ratio": 9.2, "pass": true, "src": "script" },
        { "fg": "success / warning / danger / info", "bg": "bg", "ratio": "9.1 / 9.8 / 7.4 / 9.3", "pass": true, "src": "script" },
        { "fg": "danger-fg #1C1510", "bg": "danger #F08A80", "ratio": 7.4, "pass": true, "src": "script" }
      ],
      "failures_fixed": [
        "None against the approved D4 mockup: every mockup text/background pair passes AA as drawn.",
        "border-input chosen at ink-500 #8C7862 (not in the mockup) so field outlines reach 3:1 on bg, surface and muted.",
        "decorative honey-300 is a surface only, never text."
      ]
    }
  }
}
