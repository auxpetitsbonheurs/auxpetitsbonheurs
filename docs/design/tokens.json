        "$value": {
          "fontFamily": "{font.heading}",
          "fontWeight": 500,
          "fontSize": "2.125rem",
          "lineHeight": 1.12
        },
        "$extensions": {
          "desktop": {
            "fontSize": "2.75rem"
          }
        }
      },
      "h2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.heading}",
          "fontWeight": 500,
          "fontSize": "1.75rem",
          "lineHeight": 1.2
        },
        "$extensions": {
          "desktop": {
            "fontSize": "2rem"
          }
        }
      },
      "h3": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.subheading}",
          "fontWeight": 600,
          "fontSize": "1.25rem",
          "lineHeight": 1.3
        },
        "$extensions": {
          "desktop": {
            "fontSize": "1.375rem"
          }
        }
      },
      "wordmark": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.heading}",
          "fontWeight": 500,
          "fontSize": "1.5rem",
          "lineHeight": 1.15
        },
        "$extensions": {
          "below368px": {
            "fontSize": "1.125rem"
          },
          "color": "band-fg on band"
        }
      },
      "body-lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.body}",
          "fontWeight": 400,
          "fontSize": "1.125rem",
          "lineHeight": 1.6
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.body}",
          "fontWeight": 400,
          "fontSize": "1rem",
          "lineHeight": 1.55
        }
      },
      "small": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.body}",
          "fontWeight": 400,
          "fontSize": "0.875rem",
          "lineHeight": 1.45
        },
        "$extensions": {
          "emphasisWeight": 600
        }
      },
      "price": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.body}",
          "fontWeight": 600,
          "fontSize": "1.125rem",
          "lineHeight": 1.2
        },
        "$extensions": {
          "desktop": {
            "fontSize": "1.25rem"
          },
          "tabularNums": true
        }
      }
    }
