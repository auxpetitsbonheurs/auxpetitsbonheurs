  "invoice": {
    "$type": "color",
    "$description": "The printable invoice (S-127, src/app/components/admin/invoice-sheet.tsx): paper colours after the client's template, the same in light and dark mode (a printed page), on white paper. Declared in app.css `@theme` as the `$extensions.css` variable (Tailwind `bg-invoice-band`, `text-invoice-ink`, …), with no dark override. Ratios are against white (#FFFFFF), checked by src/app/lib/tokens.test.ts.",
    "band": {
      "$value": "#5F7279",
      "$description": "Heading bands behind white uppercase text. The template's grey-blue #A4B0B5 darkened so white text meets AA (the PDF keeps the template's own band).",
      "$extensions": {
        "css": "--color-invoice-band",
        "contrast": {
          "fg": "#FFFFFF",
          "ratio": 5.04,
          "pass": true
        }
      }
    },
    "label": {
      "$value": "#4F6B7C",
      "$description": "Small labels (Invoice no., Date, Bill to).",
      "$extensions": {
        "css": "--color-invoice-label",
        "contrast": {
          "bg": "#FFFFFF",
          "ratio": 5.64,
          "pass": true
        }
      }
    },
    "ink": {
      "$value": "#3B3B3B",
      "$description": "Body text of the invoice.",
      "$extensions": {
        "css": "--color-invoice-ink",
        "contrast": {
          "bg": "#FFFFFF",
