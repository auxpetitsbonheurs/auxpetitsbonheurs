/**
 * Cloudflare Workers config (ADR-0001). Free plan.
 * Secrets are NOT stored here: set them with `wrangler secret put <NAME> --env <env>`
 * (see .dev.vars.example for the list). Locally they go in .dev.vars (gitignored).
 *
 * Only `staging` and `production` are deployable. The top level (local development) and `e2e`
 * have their own Worker names and no workers.dev URL, route or cron, so a stray bare
 * `wrangler deploy` can never replace a real Worker or serve anything. Deploy with
 * `npm run deploy:staging|deploy:production`, which build with CLOUDFLARE_ENV and run
 * scripts/check-deploy.ts first.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auxpetitsbonheurs-local",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-11-09",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"vars": {
		"APP_ENV": "development",
		"APP_TIME_ZONE": "Indian/Mauritius"
	},
	// Workers Logs keep our one structured line per request (tokens redacted, S-019 AC5).
	// Automatic invocation logs are off: they store the full URL, i.e. tracking tokens.
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "invocation_logs": false }
	},
	"upload_source_maps": true,
	"env": {
		"staging": {
			"name": "auxpetitsbonheurs-staging",
			"workers_dev": true,
			"preview_urls": false,
			// Run the Worker next to Supabase instead of near the visitor: a page makes several
			// database round trips and the visitor only one. Static assets are still served from the
			// nearest edge. The staging project is in Seoul (AWS ap-northeast-2, ADR-0003 amendment 7).
			"placement": { "mode": "targeted", "region": "aws:ap-northeast-2" },
			"vars": {
				"APP_ENV": "staging",
				"APP_TIME_ZONE": "Indian/Mauritius",
				// Not secrets: kept here because `wrangler deploy` replaces dashboard text variables.
				// RESEND_API_KEY stays a dashboard Secret (deploy-keys.md section 3b).
				"EMAIL_FROM": "Aux petits bonheurs <orders@mail.auxpetitsbonheursmu.com>",
				"SITE_URL": "https://auxpetitsbonheurs-staging.kshana-auxpetitsbonheurs.workers.dev"
			},
			// One hourly trigger per environment (free plan allows few cron triggers per account).
			// The scheduled handler dispatches jobs by Mauritius local time.
			"triggers": { "crons": ["0 * * * *"] }
		},
		// Local end-to-end tests only (S-005): built with CLOUDFLARE_ENV=e2e by the Playwright
		// harness and served by `vite preview`; never deployed. Placeholder values, no secrets;
		// the database is the throwaway local Postgres the harness resets.
		"e2e": {
			"name": "auxpetitsbonheurs-e2e",
			"workers_dev": false,
			"preview_urls": false,
			"vars": {
				"APP_ENV": "development",
				"APP_TIME_ZONE": "Indian/Mauritius",
				"SUPABASE_URL": "http://127.0.0.1:54321",
				"SUPABASE_ANON_KEY": "e2e-placeholder-anon-key",
				"SUPABASE_SERVICE_ROLE_KEY": "e2e-placeholder-service-role-key",
				"DATABASE_URL": "postgresql://postgres:postgres@127.0.0.1:5432/apb_e2e",
				"TEST_CLOCK": "on"
			}
		},
		"production": {
			"name": "auxpetitsbonheurs",
			"workers_dev": true,
			"preview_urls": false,
			// The production project is in Frankfurt (AWS eu-central-1, ADR-0003 amendment 7).
			"placement": { "mode": "targeted", "region": "aws:eu-central-1" },
			"vars": {
				"APP_ENV": "production",
				"APP_TIME_ZONE": "Indian/Mauritius"
			},
			"triggers": { "crons": ["0 * * * *"] }
		}
	}
}
