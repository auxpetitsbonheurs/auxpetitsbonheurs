# Static asset caching (S-254, NFR-001), applied by Cloudflare's asset server before the Worker.
# Vite's /assets/* files carry a content hash in their name: a new build has new names, so a
# browser may keep them for a year without asking again. Brand and sample images keep their
# names across builds: one day, then served stale while revalidated in the background.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Every static file (S-228 AC7): never sniffed as another type. Pages get the full set from the Worker.
/*
  X-Content-Type-Options: nosniff
