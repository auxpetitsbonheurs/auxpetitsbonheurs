# Local Worker secrets for `npm run dev`. Copy to .dev.vars (gitignored) and fill in.
# In staging/production set each with: wrangler secret put <NAME> --env <staging|production>
# PLACEHOLDERS ONLY. Never commit real values.
# Validated at startup by app/server/env.server.ts; a bad value fails with the variable's name.
# Only the four Supabase/database keys are required. Integration keys (Resend, VAPID, auth
# hook, Turnstile, Sentry) are optional everywhere: their feature is off until set, and
# `npm run check:launch -- <env>` / the deploy summary list the missing ones. Production's
# public launch needs email (RESEND_API_KEY, EMAIL_FROM, SITE_URL) and TURNSTILE_SECRET_KEY.

# Non-secret; set per environment in wrangler.jsonc "vars" (listed here for completeness)
APP_ENV=development
# Must be exactly Indian/Mauritius (NFR-008)
APP_TIME_ZONE=Indian/Mauritius

# Supabase (Postgres, Auth, Storage) - one project per environment, owned by the bakery
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Transaction pooler connection (port 6543) used by Drizzle at runtime
DATABASE_URL=postgresql://postgres.your-project-ref:replace-with-password@aws-0-region.pooler.supabase.com:6543/postgres

# Resend (transactional email, EN/FR templates)
RESEND_API_KEY=re_replace_with_key
EMAIL_FROM=Aux petits bonheurs <orders@example.com>
# The site's public address (origin only): every link in an email starts with it. Without
# RESEND_API_KEY, EMAIL_FROM and SITE_URL nothing is sent: emails wait in the outbox.
SITE_URL=https://replace-with-your-domain.example

# Web push (VAPID), placeholders only. Deployed sites: Actions > vapid-keys (or node scripts/set-vapid-keys.ts <env> mailto:...)
# sets all three without printing the private key. Local: leave unset (push stays off, calmly).
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:owner@example.com

# Supabase Auth "Send Email" hook secret (EN/FR auth emails rendered by the app)
SUPABASE_AUTH_HOOK_SECRET=v1,whsec_replace_with_secret

# Bot protection on public forms (Cloudflare Turnstile, free)
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret

# Error tracking (Sentry Developer plan, free)
SENTRY_DSN=https://replace@o0.ingest.sentry.io/0

# Test-only (development only; staging and production refuse to start with it set).
# The Playwright harness sets it so specs can fix "now" with the apb_test_now cookie.
# TEST_CLOCK=on
